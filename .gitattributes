* text=auto

# Unity text assets
*.asmdef text eol=lf
*.asmref text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.physicMaterial text eol=lf
